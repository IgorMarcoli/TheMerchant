APP_NAME="TheMerchant"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# Copy the Session pooler host and user from Supabase > Connect.
DB_HOST=your-session-pooler-host.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=
DB_SCHEMA=laravel,public
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Chat em tempo real: "reverb" liga o WebSocket; "log" mantém só a sincronização HTTP.
# Veja docs/CHAT_TEMPO_REAL.md. Gere ID, chave e segredo; nunca versione valores reais.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Hosts (sem protocolo) que podem abrir conexões; padrão: host de APP_URL.
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1

# Supabase Storage (S3 Protocol)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=sa-east-1
AWS_BUCKET=listings
AWS_ENDPOINT=https://qcrcjfdjsmdnlwkdkiqf.storage.supabase.co/storage/v1/s3
AWS_URL=https://qcrcjfdjsmdnlwkdkiqf.supabase.co/storage/v1/object/public/listings
AWS_USE_PATH_STYLE_ENDPOINT=true

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Desenvolvimento: log não entrega e-mail. Para SMTP e worker: docs/AUTENTICACAO.md.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contato@themerchant.local"
MAIL_FROM_NAME="${APP_NAME}"

# Gateway de pagamento (PIX via AbacatePay, API v2)
PAYMENT_GATEWAY=abacatepay
# Chave de API (use a chave de desenvolvimento enquanto estiver em dev mode)
ABACATEPAY_API_KEY=
# Segredo cadastrado no webhook da AbacatePay. A URL do webhook deve ser:
# https://SEU_DOMINIO/api/webhooks/payment?webhookSecret=ESTE_VALOR
ABACATEPAY_WEBHOOK_SECRET=
# true habilita o botão de simular pagamento (somente com chave de desenvolvimento)
ABACATEPAY_DEV_MODE=false

VITE_APP_NAME="${APP_NAME}"
